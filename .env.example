# The summaries API (~/code/summary-api): REST under /v1. Locally the auth
# gateway on :8002 fronts it and adds the token; the API itself (:8020)
# refuses requests without one.
NEXT_PUBLIC_API_URL=http://localhost:8002
# agentlite (~/code/agentlite): the agent chat, when the panel is wired.
NEXT_PUBLIC_AGENT_API_URL=http://localhost:8000
# NEXT_PUBLIC_REACT_SCAN=0   # the react-scan render overlay is on in `next dev`; 0 turns it off
